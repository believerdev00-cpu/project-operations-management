{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/apitest/(.*)", "destination": "/api/echo" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
