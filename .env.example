DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.aphahmqzfcfitviwxdig.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=admin123
PORT=5000
VITE_SUPABASE_URL=https://aphahmqzfcfitviwxdig.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_uPYaRFVbSSnLOrgWYdO3FQ_N0rKFxvA
# Comma-separated origins allowed to call the API from a browser.
# Same-origin deployments can leave this unset.
CORS_ORIGIN=http://localhost:5173

# Recovery only: set to true for one boot to re-hash ADMIN_PASSWORD onto the
# admin account, then unset it. Normal boots never touch the stored password.
ADMIN_PASSWORD_RESET=false

# ---- File storage --------------------------------------------------------
# Evidence (receipts, invoices, photographs) is written to server/uploads when
# these are unset, which is what local development uses. Set them and the same
# files go to Supabase Storage instead -- required on any host without a disk
# that survives a request, Vercel included.
#
# The service role key bypasses row level security. It is read only by server
# code and must never be given a VITE_ prefix, which would ship it to browsers.
# Create a PRIVATE bucket named below before the first upload.
SUPABASE_URL=https://aphahmqzfcfitviwxdig.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence

# ---- Serverless ----------------------------------------------------------
# On Vercel, point DATABASE_URL at Supabase's TRANSACTION POOLER (port 6543),
# not the direct connection on 5432: every warm function instance holds its own
# connection and direct connections run out quickly. Copy the exact string from
# Supabase > Project Settings > Database > Connection pooling.
# DATABASE_URL=postgresql://postgres.aphahmqzfcfitviwxdig:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
