# Postgres. `docker compose up -d` starts the one in docker-compose.yml on port
# 5433. sslmode=disable because a Postgres on this machine has no certificate;
# drop it for a database reached over a network, which should use TLS.
DATABASE_URL=postgresql://ops:ops_local_dev@localhost:5433/project_ops?sslmode=disable
# At least 32 random characters; the API refuses to start on this placeholder.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Used once, to create the `admin` Director account on the first migration. It is
# a starting password only: the Director must choose their own at first sign-in.
ADMIN_PASSWORD=admin123
PORT=5000
# Only when a reverse proxy (nginx, Caddy, IIS) sits in front of the app: the
# number of proxies, usually 1. Leave unset when the app is reached directly, or
# callers can fake their address and slip past the login limit.
# TRUST_PROXY=1
# Comma-separated origins allowed to call the API from a browser.
# Same-origin deployments (node server/index.js serving dist/) can leave this unset.
CORS_ORIGIN=http://localhost:5173

# Recovery only: set to true for one boot to re-hash ADMIN_PASSWORD onto the
# admin account, then unset it. Normal boots never touch the stored password.
ADMIN_PASSWORD_RESET=false

# Evidence (receipts, invoices, photographs) is written to server/uploads on the
# server's own disk. There is no setting for it: back that folder up together
# with the database.
